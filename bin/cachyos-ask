#!/usr/bin/env bash

# 把"手边的东西"直接交给 AI agent：选中的文字、剪贴板、或当前仓库的暂存改动。
#
# 为什么需要它：agent CLI 本身不知道你刚才看到什么。出错信息在终端里、代码在编辑器里、
# 日志在剪贴板里——每次都要"复制 → 切窗口 → 粘贴 → 补一句要求"。这个命令把最后两步省掉：
# 选动作（解释/排查/审查/总结/翻译/写提交信息/转命令），剩下的交给默认 agent。
#
# 它是 cachyos-agent 的前端：文本在这里收集与排版，启动仍走 cachyos-agent --prompt，
# 所以默认 agent、选择器、窗口类别这些行为完全一致。

set -Eeuo pipefail

readonly SCRIPT_NAME="${0##*/}"
SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SELF_DIR
readonly MAX_CHARS="${CACHYOS_ASK_MAX_CHARS:-12000}"
# 用户可编辑的动作与提示词。CACHYOS_ASK_ACTIONS 优先，便于测试隔离与临时试改。
readonly ACTIONS_FILE="${CACHYOS_ASK_ACTIONS:-${XDG_CONFIG_HOME:-$HOME/.config}/cachyos-desktop/ask-actions.conf}"

# 用户覆盖：PROMPT_OVERRIDES[动作] = 提示词；ACTION_DESCS[动作] = 选择器里显示的一行说明；
# CUSTOM_ACTION_LINES 存配置新增动作的整行 "id<TAB>说明"，追加到选择器末尾。
declare -A PROMPT_OVERRIDES=()
declare -A ACTION_DESCS=()
CUSTOM_ACTION_LINES=()

action=""
agent=""
print_only=false
show_only=false
inline=false
new_session=false

usage() {
    cat <<EOF
用法: $SCRIPT_NAME [选项] [文本...]

把选中的文字、剪贴板内容或当前仓库的暂存改动交给默认 AI agent。

选项:
  --action <名>   直接指定动作（不指定时，有终端就弹选择器）
  --agent <id>    指定 agent（默认用 cachyos-default-agent 记住的那个）
  --print         只打印将要发送的 prompt，不启动 agent（便于脚本化与自检）
  --show          只打印将要执行的启动命令，不启动
  --new           强制开新会话（默认：同一天内复用最近那个会话继续问）
  --inline        在当前终端运行 agent（默认另开 Kitty 窗口）
  --list-actions  列出所有动作（含你自定义的），一行一个 id
  -h, --help      显示本帮助

动作:
  explain    解释这段内容在做什么、关键点与坑
  fix        定位报错原因并给出可执行的修复步骤
  review     审查改动（正确性/边界/并发/安全/性能，按严重程度排序）
  summarize  用中文总结，保留关键事实与数字
  translate  翻译成自然的中文技术表达
  commit     写一条提交信息（无文本时用 git diff --cached）
  shell      把一句话变成 bash 命令

上面这 7 个动作的提示词都可以改，也能新增自己的动作——写进
  $ACTIONS_FILE
格式是每行「动作名<TAB>提示词」，例如：

  fix	下面这段输出出错了。先给结论，再用中文给出可直接执行的修复步骤。
  explain	用三句话讲清这段代码在做什么，然后列出它的坑。

改完立即生效（重开一次 cachyos-ask 即可）。覆盖内置动作时，它在选择器里的位置与顺序不变；
配置里新增的动作追加在末尾。空行与 # 开头的行会被忽略；格式不对的行会跳过并提示行号，
其余行照常生效——配置写坏了不会让命令用不了。

文本来源（按优先级）: 命令行参数 → 主选区 → 剪贴板；
commit/review 在没有文本、选区也为空时，自动改用当前仓库的暂存改动。

环境变量:
  CACHYOS_ASK_MAX_CHARS   文本上限，默认 $MAX_CHARS 字符，超出会截断并注明
  CACHYOS_ASK_SESSION     day（默认，同一天复用会话）/ new（每次都开新会话）
  CACHYOS_ASK_ACTIONS     自定义动作与提示词的文件路径（默认见上）

为什么默认复用会话：问一问的场景基本都是同一上下文里的连续追问（同一个报错、同一段代码），
每次都新开一个会话会让 agent 丢掉前文。所以默认找该 agent **当天最近的那个会话**继续问；
跨天或换 agent 时自然就开新会话。用 --new 或 CACHYOS_ASK_SESSION=new 可以强制新开。
EOF
}

# 内置动作表：**唯一**的基线来源，永远 7 条、顺序固定（测试断言这个条数）。
# 判断"某动作是不是内置"必须只查这里——用别处被配置填充过的表会导致内置项重复出现。
builtin_actions() {
    cat <<'ACTIONS'
explain	解释：这段在做什么、关键点与坑
fix	排查：定位报错原因 + 可执行的修复步骤
review	审查：改动里的真问题，按严重程度排序
summarize	总结：保留关键事实与数字
translate	翻译：翻成自然的中文技术表达
commit	提交信息：按暂存改动写一条规范的 commit message
shell	转命令：把一句话变成可执行的 bash 命令
ACTIONS
}

is_builtin_action() {
    builtin_actions | cut -f1 | grep -qx -- "$1"
}

actions() {
    local id desc
    # 内置动作保持原位置与原顺序，只把说明换成用户覆盖后的提示词。
    while IFS=$'\t' read -r id desc; do
        [[ -n $id ]] || continue
        printf '%s\t%s\n' "$id" "${ACTION_DESCS[$id]:-$desc}"
    done < <(builtin_actions)

    # 配置里新增的动作追加在末尾（关联数组顺序不定，所以用单独的数组保序）。
    ((${#CUSTOM_ACTION_LINES[@]} == 0)) || printf '%s\n' "${CUSTOM_ACTION_LINES[@]}"
}

# 用户自定义动作与提示词。文件缺失、缺权限都只是"没有自定义"，绝不能因此让命令失败。
#
# 为什么用 tab 分隔而不是更花哨的 INI/TOML：这里只需要"id → 一段话"这一种数据，而
# actions()/fzf 本来就用 tab 对齐；多一层解析器就多一处会坏的地方。
load_actions_config() {
    local file="$ACTIONS_FILE"
    local line line_number=0
    local id="" value=""
    local -a invalid=()

    if [[ ! -e $file ]]; then
        return 0
    fi
    if [[ ! -r $file ]]; then
        warn_config "$file 不可读，忽略自定义提示词"
        return 0
    fi

    while IFS= read -r line || [[ -n $line ]]; do
        line_number=$((line_number + 1))
        line="${line%$'\r'}"
        [[ -z $line ]] && continue
        [[ $line == \#* ]] && continue

        # tab 是唯一分隔符。用参数展开而不是 cut：cut 对空字段的处理取决于实现，
        # 而这里"prompt 为空"恰恰是最需要报错的输入。
        id="${line%%$'\t'*}"
        if [[ $id == "$line" ]]; then
            # 没有 tab：既不是"id<TAB>提示词"，也不是"id=提示词"。
            id="${line%%=*}"
            value="${line#*=}"
            if [[ $id == "$line" ]]; then
                invalid+=("$line_number")
                continue
            fi
        else
            value="${line#*$'\t'}"
        fi

        # 空提示词与非法 id 是唯一两种无效情况；其余一律按"覆盖提示词"处理。
        if [[ ! $id =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]] || [[ -z ${value//[[:space:]]/} ]]; then
            invalid+=("$line_number")
            continue
        fi

        PROMPT_OVERRIDES["$id"]="$value"

        if is_builtin_action "$id"; then
            # 内置动作：只换提示词，位置与顺序都保持原样（列表里不能出现两条同 id）。
            ACTION_DESCS["$id"]="$value"
            continue
        fi
        ACTION_DESCS["$id"]="$value"
        CUSTOM_ACTION_LINES+=("$(printf '%s\t%s' "$id" "$value")")
    done < "$file"

    ((${#invalid[@]} == 0)) || warn_config \
        "$file 第 ${invalid[*]} 行不是 'id<TAB>提示词'，已跳过；其余已生效"
}

warn_config() {
    printf '%s: %s\n' "$SCRIPT_NAME" "$1" >&2
}

# 取某个动作的提示词：用户覆盖优先，其次内置模板。
action_prompt() {
    if [[ -v PROMPT_OVERRIDES[$1] ]]; then
        printf '%s' "${PROMPT_OVERRIDES[$1]}"
        return 0
    fi
    template_for "$1"
}

template_for() {
    case "$1" in
        explain)
            printf '解释下面这段内容：它在做什么、关键点是什么、有没有坑。先给结论再展开。'
            ;;
        fix)
            printf '下面这段输出出错了。请定位原因，并给出可直接执行的修复步骤（先给结论，再给命令或补丁）。'
            ;;
        review)
            printf '审查下面的改动，只指出真实问题（正确性、边界条件、并发、安全、性能），按严重程度排序，不要泛泛而谈。'
            ;;
        summarize)
            printf '用中文总结下面这段内容，保留关键事实与数字，不要添加评论。'
            ;;
        translate)
            printf '把下面内容翻译成自然的中文技术表达，代码、命令与专有名词保留原文。'
            ;;
        commit)
            printf '根据下面的改动写一条提交信息：第一行不超过 72 字符、用祈使句，需要时再补正文列表。只输出提交信息本身。'
            ;;
        shell)
            printf '把下面这句话转换成可执行的 bash 命令，先给命令，再逐条简要说明参数；如有危险操作请显式提醒。'
            ;;
        *)
            return 1
            ;;
    esac
}

valid_action() {
    actions | cut -f1 | grep -qx -- "$1"
}

# 读取主选区/剪贴板；没有 wl-clipboard 或内容为空都返回空。
primary_selection() {
    command -v wl-paste >/dev/null 2>&1 || return 0
    wl-paste --primary --no-newline 2>/dev/null || true
}

clipboard_text() {
    command -v wl-paste >/dev/null 2>&1 || return 0
    wl-paste --no-newline 2>/dev/null || true
}

staged_changes() {
    command -v git >/dev/null 2>&1 || return 0
    git rev-parse --is-inside-work-tree >/dev/null 2>&1 || return 0
    local diff
    diff="$(git diff --cached --no-color 2>/dev/null || true)"
    [[ -n $diff ]] || return 0
    printf '（仓库：%s，分支：%s，以下为 git diff --cached）\n%s' \
        "$(git rev-parse --show-toplevel 2>/dev/null)" \
        "$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" \
        "$diff"
}

truncate_text() {
    local text="$1"
    if ((${#text} > MAX_CHARS)); then
        printf '%s\n\n…（内容过长，已截断到前 %d 个字符）' "${text:0:MAX_CHARS}" "$MAX_CHARS"
    else
        printf '%s' "$text"
    fi
}

pick_action() {
    local selection_file inner
    # stdin 是管道时（脚本调用）不能用 fzf 的默认界面，所以要判断的不是 stdout。
    if [[ -t 0 ]]; then
        actions | fzf --delimiter='\t' --with-nth=2 --prompt='要做什么> ' --reverse | cut -f1
        return 0
    fi
    if ! command -v kitty >/dev/null 2>&1; then
        printf 'explain'
        return 0
    fi
    selection_file="$(mktemp)"
    inner="$(printf '%q' "$SELF_DIR/$SCRIPT_NAME") --list-actions | fzf --delimiter='\t' --with-nth=2 --prompt='要做什么> ' --reverse | cut -f1"
    if kitty --class cachyos-agent-pick sh -c "$inner > $(printf '%q' "$selection_file")"; then
        cat "$selection_file" 2>/dev/null || true
    fi
    rm -f "$selection_file"
}

# ------------------------------------------------------------------ 参数
# 先加载用户自定义动作/提示词，后面 --list-actions、valid_action、模板选择都要用它。
load_actions_config

text_args=()
while (($# > 0)); do
    case "$1" in
        --action)
            [[ -n ${2:-} ]] || { printf '%s: --action 需要参数\n' "$SCRIPT_NAME" >&2; exit 2; }
            action="$2"
            shift 2
            ;;
        --agent)
            [[ -n ${2:-} ]] || { printf '%s: --agent 需要参数\n' "$SCRIPT_NAME" >&2; exit 2; }
            agent="$2"
            shift 2
            ;;
        --print)
            print_only=true
            shift
            ;;
        --show)
            show_only=true
            shift
            ;;
        --new)
            new_session=true
            shift
            ;;
        --inline)
            inline=true
            shift
            ;;
        --list-actions)
            actions
            exit 0
            ;;
        -h | --help)
            usage
            exit 0
            ;;
        --)
            shift
            text_args+=("$@")
            break
            ;;
        -*)
            printf '%s: 未知参数 %s\n' "$SCRIPT_NAME" "$1" >&2
            usage >&2
            exit 2
            ;;
        *)
            text_args+=("$1")
            shift
            ;;
    esac
done

if [[ -n $action ]] && ! valid_action "$action"; then
    printf '%s: 不支持的动作 %s\n可用动作: %s\n' \
        "$SCRIPT_NAME" "$action" "$(actions | cut -f1 | tr '\n' ' ')" >&2
    exit 2
fi

if [[ -z $action ]]; then
    action="$(pick_action)"
    [[ -n $action ]] || action="explain"
    valid_action "$action" || action="explain"
fi

# ------------------------------------------------------------------ 收集文本
text=""
source_label=""
if ((${#text_args[@]} > 0)); then
    text="${text_args[*]}"
    source_label="命令行给出的文本"
else
    if [[ $action == commit || $action == review ]]; then
        text="$(staged_changes)"
        [[ -n $text ]] && source_label="当前仓库的暂存改动"
    fi
    if [[ -z $text ]]; then
        text="$(primary_selection)"
        [[ -n $text ]] && source_label="当前选中的文字"
    fi
    if [[ -z $text ]]; then
        text="$(clipboard_text)"
        [[ -n $text ]] && source_label="剪贴板内容"
    fi
fi

if [[ -z ${text//[[:space:]]/} ]]; then
    printf '%s: 没有拿到任何文本。\n' "$SCRIPT_NAME" >&2
    printf '  请先选中一段文字、复制到剪贴板，或直接把文本作为参数传进来；\n' >&2
    printf '  例如：%s --action fix "make: *** [Makefile:3: all] Error 1"\n' "$SCRIPT_NAME" >&2
    exit 3
fi

prompt="$(action_prompt "$action")"
[[ -n $source_label ]] && prompt+=$'\n\n'"（以下是$source_label）"
prompt+=$'\n\n---\n'
prompt+="$(truncate_text "$text")"

if [[ $print_only == true ]]; then
    printf '%s\n' "$prompt"
    exit 0
fi

# ------------------------------------------------------------------ 同一天复用会话
# 目标 agent：显式指定的，或当前默认的（没有默认值时 cachyos-agent 会弹选择器，
# 那种情况下无法预先知道是哪个 agent，于是不复用、直接开新会话）。
target_agent="$agent"
if [[ -z $target_agent ]]; then
    target_agent="$(cachyos-default-agent 2>/dev/null || true)"
fi

resume_id=""
reuse=true
[[ $new_session == true || ${CACHYOS_ASK_SESSION:-} == new ]] && reuse=false

if [[ $reuse == true && -n $target_agent ]]; then
    # 会话枚举复用 cachyos-agent-resume（它已经读遍了四个工具的存储，且有测试）。
    # 优先用同目录的兄弟命令：仓库内运行时行为确定（也便于测试隔离到假 HOME）。
    resume_helper="$SELF_DIR/cachyos-agent-resume"
    [[ -x $resume_helper ]] || resume_helper="$(command -v cachyos-agent-resume 2>/dev/null || true)"
    latest=""
    if [[ -n $resume_helper ]]; then
        latest="$("$resume_helper" --list --agent "$target_agent" --limit 1 2>/dev/null | head -1 || true)"
    fi
    if [[ -n $latest ]]; then
        latest_epoch="$(cut -f2 <<<"$latest")"
        latest_id="$(cut -f6 <<<"$latest")"
        if [[ $latest_epoch =~ ^[0-9]+$ && -n $latest_id ]]; then
            if [[ "$(date -d "@$latest_epoch" +%Y-%m-%d 2>/dev/null)" == "$(date +%Y-%m-%d)" ]]; then
                resume_id="$latest_id"
            fi
        fi
    fi
fi

# ------------------------------------------------------------------ 交给 agent
launch_args=()
[[ $inline == true ]] && launch_args+=(--inline)
[[ -n $target_agent ]] && launch_args+=("$target_agent")
[[ -n $resume_id ]] && launch_args+=(--resume "$resume_id")
launch_args+=(--prompt "$prompt")

if command -v cachyos-agent >/dev/null 2>&1; then
    agent_command=(cachyos-agent)
else
    agent_command=("$SELF_DIR/cachyos-agent")
fi

if [[ $show_only == true ]]; then
    printf '%s' "${agent_command[0]}"
    printf ' %q' "${launch_args[@]}"
    printf '\n'
    exit 0
fi

exec "${agent_command[@]}" "${launch_args[@]}"
