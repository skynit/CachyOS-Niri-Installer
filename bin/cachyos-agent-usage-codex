#!/usr/bin/env python3
"""采集 Codex 的用量，输出一条 display-ready JSON 记录。

数据来源：`~/.codex/sessions/**/rollout-*.jsonl` 与 `~/.codex/archived_sessions/`。
每行是 `{timestamp, ordinal, type, payload}`，其中：

- `payload.type == "session_meta"` —— 会话 id / cwd / 起始时间
- `payload.type == "token_count"` —— 同时带 `info.total_token_usage`（会话累计）与
  `info.last_token_usage`（本轮增量）。**必须用增量**：累计值会把整个会话的 token
  全部算到最后一个事件所在的那一天。
- 模型名散在若干路径（`payload.model`、`payload.thread_settings.model` 等），
  按"最近一次见到"归属到后续的 token 事件；找不到就记 unknown，绝不猜。
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path
from typing import Any

AGENT_ID = "codex"
AGENT_NAME = "Codex"
MODEL_PATHS = (
    ("model",),
    ("thread_settings", "model"),
    ("state", "model"),
    ("collaboration_mode", "settings", "model"),
)


def lib_dir() -> Path:
    """先找与自己同仓库的 lib，再退回 share 里的安装副本。

    顺序很重要：从仓库直接运行、而 share 里还是旧副本时，若优先用 share，
    就会出现"刚加的函数不存在"这种假故障（改动明明在，跑的却是旧代码）。
    """
    sibling = Path(__file__).resolve().parent.parent / "assets" / "lib"
    if (sibling / "agent_usage.py").is_file():
        return sibling
    share = os.environ.get("CACHYOS_DESKTOP_SHARE_DIR") or "/usr/local/share/cachyos-desktop"
    return Path(share) / "assets" / "lib"


sys.path.insert(0, str(lib_dir()))
import agent_usage as au  # noqa: E402


def codex_dir() -> Path:
    return Path(os.environ.get("CODEX_HOME") or (Path.home() / ".codex")).expanduser()


def model_from_payload(payload: dict[str, Any]) -> str:
    for path in MODEL_PATHS:
        node: Any = payload
        for key in path:
            if not isinstance(node, dict):
                node = None
                break
            node = node.get(key)
        if isinstance(node, str) and node:
            return node
    return ""


def counters_from(usage: dict[str, Any]) -> dict[str, int]:
    return {
        "inputTokens": au.as_int(usage.get("input_tokens")),
        "outputTokens": au.as_int(usage.get("output_tokens")),
        "cacheReadInputTokens": au.as_int(usage.get("cached_input_tokens")),
        "cacheCreationInputTokens": au.as_int(usage.get("cache_write_input_tokens")),
    }


TOTAL_FIELDS = (
    "input_tokens",
    "cached_input_tokens",
    "cache_write_input_tokens",
    "output_tokens",
    "reasoning_output_tokens",
    "total_tokens",
)


def total_signature(total: Any) -> tuple[int, ...] | None:
    """把 total_token_usage 归一成可比较的元组（缺失时为 None）。"""
    if not isinstance(total, dict):
        return None
    return tuple(au.as_int(total.get(field)) for field in TOTAL_FIELDS)


def scan_rollouts(cache: dict[str, Any]) -> tuple[dict[str, Any], dict[str, dict[str, int]], set[str], int]:
    """增量扫描 rollout，返回 (per_day, model_usage, sessions, prompts)。

    关键点（都有真实数据佐证）：

    1. **跳过"没有前进"的 token_count 快照。** Codex 偶尔会把同一份 total_token_usage 和
       同一份 last_token_usage 再发一遍（实测 84,964 个事件里有 1,366 个，全部是上一事件的
       逐字节重复）。照单全收会多算 2.3 亿输入 token（费用 +2.44%）。
    2. **模型优先取 turn_context.model。** 它是这一轮的权威来源；`state.model` /
       `thread_settings.model` 只作为回退，否则会被别的线程设置带偏（实测 0.63% 的 token
       归属到错误的模型）。
    3. **按日 prompt 数进缓存并重放**、**读取失败的文件整份跳过且不缓存**，理由同 Claude 采集器。
    """
    roots = [codex_dir() / "sessions", codex_dir() / "archived_sessions"]
    files = au.collect_files(roots, "rollout-*.jsonl")
    per_day: dict[str, Any] = {}
    model_usage: dict[str, dict[str, int]] = {}
    sessions: set[str] = set()
    prompts = 0
    known = cache.setdefault("files", {})
    seen: dict[str, Any] = {}

    for path in files:
        stamp = au.file_stamp(path)
        key = str(path)
        if not stamp:
            continue

        cached = known.get(key)
        if cached and cached.get("stamp") == stamp:
            seen[key] = cached
            for date, entry in (cached.get("perDay") or {}).items():
                for model, counters in (entry.get("byModel") or {}).items():
                    au.merge_day(per_day, date, counters, model)
                day_prompts = au.as_int(entry.get("prompts", 0))
                if day_prompts > 0:
                    au.merge_day(
                        per_day, date, au.empty_counters(), "", day_prompts, entry.get("session") or ""
                    )
                if entry.get("session"):
                    sessions.add(entry["session"])
            for model, counters in (cached.get("models") or {}).items():
                au.add_counters(model_usage.setdefault(model, au.empty_counters()), counters)
            prompts += au.as_int(cached.get("prompts", 0))
            continue

        status = {"ok": True}
        file_per_day: dict[str, Any] = {}
        file_models: dict[str, dict[str, int]] = {}
        file_prompts = 0
        session_id = ""
        day_prompts: dict[str, int] = {}
        turn_model = ""
        fallback_model = ""
        previous_total: tuple[int, ...] | None = None

        for entry in au.iter_jsonl(path, status):
            if not isinstance(entry, dict):
                continue
            payload = entry.get("payload")
            if not isinstance(payload, dict):
                continue
            # 事件类型有两个来源：多数在 payload.type，但 session_meta 这类在行顶层的 type 上。
            kind = payload.get("type") or entry.get("type")

            if kind == "session_meta":
                session_id = str(payload.get("session_id") or payload.get("id") or session_id)
                found = model_from_payload(payload)
                if found and not fallback_model:
                    fallback_model = found
                continue

            if kind == "turn_context":
                # 这一轮的权威模型；后续事件都归到它头上。
                found = model_from_payload(payload)
                if found:
                    turn_model = found
                continue

            found = model_from_payload(payload)
            if found and not fallback_model:
                fallback_model = found

            if kind == "task_started":
                date = au.local_date(entry.get("timestamp"))
                if date:
                    file_prompts += 1
                    day_prompts[date] = day_prompts.get(date, 0) + 1
                    if session_id:
                        sessions.add(session_id)
                continue

            if kind != "token_count":
                continue

            info = payload.get("info")
            if not isinstance(info, dict):
                continue
            usage = info.get("last_token_usage")
            if not isinstance(usage, dict):
                continue

            counters = counters_from(usage)
            total = total_signature(info.get("total_token_usage"))
            # total 没前进、但 last 非零 ⇒ 这是上一事件的重复快照，跳过。
            if total is not None and total == previous_total and any(counters.values()):
                continue
            if total is not None:
                previous_total = total

            date = au.local_date(entry.get("timestamp"))
            if not date:
                continue
            model = turn_model or fallback_model or "unknown"
            day = file_per_day.setdefault(date, {"byModel": {}, "prompts": 0, "session": session_id})
            au.add_counters(day["byModel"].setdefault(model, au.empty_counters()), counters)
            au.merge_day(per_day, date, counters, model)
            au.add_counters(file_models.setdefault(model, au.empty_counters()), counters)
            if session_id:
                sessions.add(session_id)

        if not status["ok"]:
            # 读失败：整份文件不参与统计，也不写缓存（下次重试）。
            continue

        # 只要文件里有会话 id 就登记，哪怕它没有任何用量或 prompt
        # （例如刚开就中断的会话）——否则会话数会随解析方式变化而漂移。
        if session_id:
            sessions.add(session_id)

        for date, count in day_prompts.items():
            day = file_per_day.setdefault(date, {"byModel": {}, "prompts": 0, "session": session_id})
            day["prompts"] = au.as_int(day.get("prompts")) + count
            au.merge_day(per_day, date, au.empty_counters(), "", count, session_id)

        prompts += file_prompts
        for model, counters in file_models.items():
            au.add_counters(model_usage.setdefault(model, au.empty_counters()), counters)
        seen[key] = {
            "stamp": stamp,
            "perDay": file_per_day,
            "models": file_models,
            "prompts": file_prompts,
            "session": session_id,
        }

    cache["files"] = seen
    return per_day, model_usage, sessions, prompts


def main() -> int:
    parser = argparse.ArgumentParser(description="采集 Codex 用量")
    parser.add_argument("--force", action="store_true", help="忽略缓存，全量重扫")
    parser.add_argument("--limits-only", action="store_true", help="只取限额（Codex 走 app-server RPC，暂无）")
    args = parser.parse_args()

    if args.limits_only:
        per_day: dict[str, Any] = {}
        model_usage: dict[str, dict[str, int]] = {}
        sessions: set[str] = set()
        prompts = 0
    else:
        cache = {"files": {}} if args.force else au.load_cache(AGENT_ID)
        per_day, model_usage, sessions, prompts = scan_rollouts(cache)
        au.finalise_sessions(per_day)
        if not args.force:
            au.save_cache(AGENT_ID, cache)

    record = {
        "schemaVersion": au.SCHEMA_VERSION,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "ready": bool(per_day),
        "hasLocalStats": bool(per_day),
        "tierLabel": "",
        "limits": [],
        "usageStatusText": "" if per_day else "没有找到 Codex 会话记录",
        "inputTokenSemantics": "inclusive",
        "stats": au.build_stats(
            per_day,
            model_usage,
            sessions,
            prompts,
            input_includes_cache=True,
            pricing=au.ccswitch_pricing(),
        ),
        "updatedAt": au.dt.datetime.now().astimezone().isoformat(timespec="seconds"),
    }
    au.write_record(AGENT_ID, record)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
