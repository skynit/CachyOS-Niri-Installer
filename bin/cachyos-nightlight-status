#!/usr/bin/env bash

set -uo pipefail
pid_file="${XDG_RUNTIME_DIR:-$HOME/.cache}/cachyos-nightlight/pid"
if [[ -s "$pid_file" ]] && kill -0 "$(<"$pid_file")" 2>/dev/null; then
    printf '%s\n' '{"text":"Night","class":"enabled","tooltip":"Night light enabled"}'
else
    printf '%s\n' '{"text":"Day","class":"disabled","tooltip":"Night light disabled"}'
fi
