#!/usr/bin/env bash

set -Eeuo pipefail

readonly SCRIPT_NAME="${0##*/}"
readonly SHARE_DIR="${CACHYOS_DESKTOP_SHARE_DIR:-/usr/local/share/cachyos-desktop}"

# 先赋值再 readonly：readonly 会掩盖命令替换的失败，而这里失败会让后续 $SELF_DIR/...
# 静默指向根目录。
SELF_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
readonly SELF_DIR

# 随包资源；从仓库直接运行时回落到仓库内的副本。
ASSET_DIR="$SHARE_DIR/assets"
if [[ ! -d $ASSET_DIR/agent-skills ]]; then
    ASSET_DIR="$SELF_DIR/../assets"
fi

agent_lib="$SHARE_DIR/assets/lib/agent.sh"
if [[ ! -r $agent_lib ]]; then
    agent_lib="$SELF_DIR/../assets/lib/agent.sh"
fi
# shellcheck source=assets/lib/agent.sh
source "$agent_lib" || {
    printf '找不到 agent 表：%s\n' "$agent_lib" >&2
    exit 1
}

usage() {
    cat <<EOF
Usage: $SCRIPT_NAME [--quiet] [--harness <agent>]

把本项目的 agent 技能软链到各 harness 的技能目录。

只为**已存在**的目录建立软链，绝不创建 harness 目录；重复执行是幂等的。
用软链而非拷贝，因此重跑 ./install.sh 更新资源后立即生效。

Options:
  --quiet             只在出错时输出
  --harness <agent>   只处理该 agent 的技能目录
  -h, --help          显示本帮助
EOF
}

# 技能名就是 assets/agent-skills/ 下的目录名。
skill_names() {
    local path

    for path in "$ASSET_DIR"/agent-skills/*/; do
        [[ -d $path ]] || continue
        basename -- "$path"
    done
}

# 全部已知的 harness 技能目录，$HOME 相对。
known_skill_relpaths() {
    printf '%s\n' \
        '.agents/skills' \
        '.claude/skills' \
        '.codex/skills' \
        '.gemini/config/skills' \
        '.pi/agent/skills' \
        '.hermes/skills' \
        '.cc-switch/skills'

    local profile
    for profile in "$HOME"/.hermes/profiles/*/skills; do
        [[ -d $profile ]] || continue
        printf '%s\n' "${profile#"$HOME"/}"
    done
}

link_into() {
    local directory="$1"
    local skill
    local target
    local count=0
    local skipped=0
    local failed=0

    if [[ ! -d $directory ]]; then
        if [[ $quiet == false ]]; then
            printf '跳过（目录不存在）  %s\n' "${directory#"$HOME"/}"
        fi
        return 0
    fi

    while IFS= read -r skill; do
        target="$directory/$skill"

        # 目标是真实文件/目录时 ln -sfn 不会替换它：会把软链塞进目录里（嵌套），技能在
        # harness 期望的路径上依然不可见；对同名真实文件则更糟。所以显式跳过，不碰用户内容。
        if [[ -e $target && ! -L $target ]]; then
            printf '跳过：%s 已存在且不是软链（不覆盖你的内容）\n' "${target#"$HOME"/}" >&2
            skipped=$((skipped + 1))
            continue
        fi

        # 单个目标失败（例如目录不可写）不能中止其余 harness 的处理。
        if ln -sfn "$ASSET_DIR/agent-skills/$skill" "$target"; then
            count=$((count + 1))
        else
            printf '无法链接：%s\n' "${target#"$HOME"/}" >&2
            failed=$((failed + 1))
        fi
    done < <(skill_names)

    if [[ $quiet == false ]]; then
        printf '已链接 %d 个技能到 %s' "$count" "${directory#"$HOME"/}"
        if ((skipped > 0)); then
            printf '（跳过 %d 个已存在项）' "$skipped"
        fi
        if ((failed > 0)); then
            printf '（%d 个失败）' "$failed"
        fi
        printf '\n'
    fi

    ((failed == 0))
}

main() {
    local quiet=false
    local harness=""
    local relpath
    local relpaths
    local status=0

    while (($# > 0)); do
        case "$1" in
            --quiet)
                quiet=true
                shift
                ;;
            --harness)
                (($# >= 2)) || { usage >&2; return 2; }
                harness="$2"
                shift 2
                ;;
            -h|--help)
                usage
                return 0
                ;;
            --)
                # 选项终止符；本命令没有位置参数，停止解析即可。
                shift
                break
                ;;
            *)
                printf '未知选项：%s\n' "$1" >&2
                return 2
                ;;
        esac
    done

    if (($# > 0)); then
        printf '不接受位置参数：%s\n' "$1" >&2
        return 2
    fi

    if [[ ! -d $ASSET_DIR/agent-skills ]]; then
        printf '找不到技能资源目录：%s\n' "$ASSET_DIR/agent-skills" >&2
        return 1
    fi

    # 单个目录失败不影响其余目录；全部处理完再汇总退出码。
    if [[ -n $harness ]]; then
        if ! relpaths="$(cachyos_agent_skill_relpaths "$harness")"; then
            printf '不支持的 agent：%s\n' "$harness" >&2
            return 2
        fi
        while IFS= read -r relpath; do
            [[ -n $relpath ]] || continue
            link_into "$HOME/$relpath" || status=1
        done <<< "$relpaths"
        return "$status"
    fi

    while IFS= read -r relpath; do
        [[ -n $relpath ]] || continue
        link_into "$HOME/$relpath" || status=1
    done < <(known_skill_relpaths)

    return "$status"
}

main "$@"
