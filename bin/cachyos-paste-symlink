#!/usr/bin/env bash

set -Eeuo pipefail
[[ $# -eq 1 && -d "$1" ]] || { printf 'Usage: %s DIRECTORY\n' "${0##*/}" >&2; exit 2; }

python - "$1" <<'PY'
import os
import pathlib
import subprocess
import sys
import urllib.parse

destination = pathlib.Path(sys.argv[1])
clipboard = subprocess.run(
    ["wl-paste", "--type", "text/uri-list"],
    check=True,
    capture_output=True,
    text=True,
).stdout

for line in clipboard.splitlines():
    if not line or line.startswith("#"):
        continue
    uri = urllib.parse.urlparse(line)
    if uri.scheme != "file":
        continue
    source = pathlib.Path(urllib.parse.unquote(uri.path))
    target = destination / source.name
    suffix = 1
    while target.exists() or target.is_symlink():
        target = destination / f"{source.stem}-{suffix}{source.suffix}"
        suffix += 1
    os.symlink(source, target)
PY
