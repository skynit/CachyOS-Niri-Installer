#!/usr/bin/env bash

# 安装本地听写：Voxtype + Whisper 语音模型（约 150MB）。
#
# 刻意不放进默认安装：模型体积不小，听写也不是所有人的需求。
# 装包需要 sudo，而本命令可能从快捷键触发（没有终端），因此沿用仓库既有的
# "没有终端就用 Kitty 重开自己来问密码"模式（同 cachyos-snapshot）。

set -Eeuo pipefail

readonly SCRIPT_NAME="${0##*/}"
readonly SHARE_DIR="${CACHYOS_DESKTOP_SHARE_DIR:-/usr/local/share/cachyos-desktop}"

# 上游默认模型是**英文专用**的 base.en：中文会输出一段乱码拼音（实测）。
# 所以把模型/语言/提示词做成安装参数，并在结束后按实际配置给出提示。
MODEL=""
LANGUAGE=""
INITIAL_PROMPT=""

usage() {
    cat <<EOF
用法: $SCRIPT_NAME [选项]
  --model <名称>      设置 Whisper 模型（small、medium、large-v3-turbo …）
  --language <代码>   设置语言（zh、en、ja …；auto 为自动检测）
  --prompt <文本>     设置 initial_prompt（用简体中文提示词可让中文输出简体）
  -h, --help          显示本帮助

中文听写示例：
  $SCRIPT_NAME --model small --language zh \\
      --prompt '以下是普通话的句子，请使用简体中文。'
EOF
}

parse_args() {
    while (($# > 0)); do
        case "$1" in
            --model | --language | --prompt)
                if [[ -z ${2:-} ]]; then
                    printf '%s: %s 需要参数\n' "$SCRIPT_NAME" "$1" >&2
                    exit 1
                fi
                case "$1" in
                    --model) MODEL="$2" ;;
                    --language) LANGUAGE="$2" ;;
                    --prompt) INITIAL_PROMPT="$2" ;;
                esac
                shift 2
                ;;
            -h | --help)
                usage
                exit 0
                ;;
            *)
                printf '%s: 未知参数 %s\n' "$SCRIPT_NAME" "$1" >&2
                usage >&2
                exit 1
                ;;
        esac
    done
}

reload_niri() {
    command -v niri >/dev/null 2>&1 || return 0
    # 子命令名在不同 niri 版本间变过：当前版本是 load-config-file，旧版叫 reload-config。
    # 两个都试一遍，都失败也无所谓——重载配置不是致命步骤（而且原来的写法在本机
    # niri 上直接报 unrecognized subcommand，等于**从来没重载过**）。
    niri msg action load-config-file >/dev/null 2>&1 && return 0
    niri msg action reload-config >/dev/null 2>&1 || true
}

notify() {
    if command -v dms >/dev/null 2>&1; then
        dms notify "$1" >/dev/null 2>&1 || true
    else
        notify-send "本地听写" "$1" 2>/dev/null || true
    fi
}

# 先解析参数：这样 --help 在没有终端时也能用，且重开终端时原样带上参数。
parse_args "$@"

if [[ ! -t 0 || ! -t 1 ]]; then
    if [[ "${CACHYOS_VOXTYPE_TERMINAL:-0}" != 1 ]]; then
        command -v kitty >/dev/null 2>&1 || {
            printf '找不到 Kitty，无法请求 sudo 密码；请在终端里运行 %s。\n' "$SCRIPT_NAME" >&2
            notify "找不到 Kitty，无法请求密码；请在终端里运行 cachyos-voxtype-install。"
            exit 1
        }
        exec kitty --class cachyos-voxtype --title "安装本地听写" \
            -e env CACHYOS_VOXTYPE_TERMINAL=1 "$0" "$@"
    fi
fi

if ! command -v voxtype >/dev/null 2>&1; then
    command -v paru >/dev/null 2>&1 || {
        printf '找不到 paru（AUR 助手），无法安装 voxtype-bin。\n' >&2
        exit 1
    }
    printf '安装 voxtype-bin 与 wtype…\n'
    paru -S --needed --noconfirm -- wtype voxtype-bin
else
    printf 'voxtype 已安装，跳过装包。\n'
fi

install -d -m 0755 "$HOME/.config/voxtype"
if [[ -e "$HOME/.config/voxtype/config.toml" ]]; then
    # 不覆盖：用户可能已经调过设备、采样率或提示音。
    printf '保留已有的 ~/.config/voxtype/config.toml。\n'
else
    install -m 0644 "$SHARE_DIR/assets/voxtype/config.toml" "$HOME/.config/voxtype/config.toml"
fi

# **顺序很重要**：`voxtype setup --download` 下载的是**配置里**指定的模型，
# 先下载再改模型就会拿到默认的英文模型（原来的写法就是这个坑）。
if [[ -n $MODEL ]]; then
    voxtype config set whisper.model "$MODEL" >/dev/null
fi
if [[ -n $LANGUAGE ]]; then
    voxtype config set whisper.language "$LANGUAGE" >/dev/null
fi
if [[ -n $INITIAL_PROMPT ]]; then
    voxtype config set whisper.initial_prompt "$INITIAL_PROMPT" >/dev/null
fi

printf '下载语音模型（默认约 150MB；多语言模型更大）…\n'
voxtype setup --download --no-post-install

# GPU 加速：切换变体会**替换 /usr/bin/voxtype**，必须 sudo。
# 不加 sudo 时 `setup gpu --enable` 只会报 permission denied，然后静默留在 CPU 上（实测）。
if compgen -G '/dev/dri/renderD*' >/dev/null; then
    if ! sudo voxtype setup gpu --enable; then
        printf 'GPU 加速未启用，继续用 CPU 推理。\n' >&2
    fi
else
    printf '没有可用的 GPU 渲染节点，使用 CPU 推理。\n'
fi

voxtype setup systemd

# 快捷键：Niri 没有条件绑定，所以用"可选 include"实现"装了听写才有这几个键"。
# 直接写进 binds.kdl 会让没用听写的人白白失去它们（裸 F9 更是应用自己的功能键）。
install -m 0644 "$SHARE_DIR/assets/niri/cachyos-voxtype.kdl" "$HOME/.config/niri/cachyos-voxtype.kdl"
reload_niri

# 模型/语言/提示词都是启动时读取的，改过就重启一次，免得"改了没生效"。
if [[ -n $MODEL || -n $LANGUAGE || -n $INITIAL_PROMPT ]]; then
    systemctl --user restart voxtype.service >/dev/null 2>&1 || true
fi

# 英文专用模型（*.en）不能听写中文：装完直接把命令打出来，而不是让人对着乱码猜。
active_model="$(voxtype config get whisper.model 2>/dev/null || true)"
if [[ $active_model == *".en"* ]]; then
    printf '\n提示：当前模型 %s 只支持英文，中文会被转成乱码拼音。听写中文请执行：\n' "$active_model"
    printf '  cachyos-voxtype-model small    # 多语言模型，约 466MB\n'
    printf '  voxtype config set whisper.language zh\n'
    printf "  voxtype config set whisper.initial_prompt '以下是普通话的句子，请使用简体中文。'\n"
    printf '  systemctl --user restart voxtype\n'
fi

printf '本地听写已就绪：按 Super+Ctrl+X（或 Super+F9）开始/结束。\n'
notify "本地听写已就绪：按 Super+Ctrl+X 开始/结束。"

if [[ "${CACHYOS_VOXTYPE_TERMINAL:-0}" == 1 ]]; then
    printf '\n按 Enter 关闭窗口。'
    # 没有 stdin（例如非交互调用）时 read 会返回非 0，不能让 set -e 把它当成失败。
    read -r || true
fi
