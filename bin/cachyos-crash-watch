#!/usr/bin/env bash

# 监听 systemd-coredump 并提示用 AI 诊断。由 cachyos-crash-watch.service 常驻运行。

set -Eeuo pipefail

ai_settings_lib="${CACHYOS_DESKTOP_SHARE_DIR:-/usr/local/share/cachyos-desktop}/assets/lib/ai-settings.sh"
[[ -r $ai_settings_lib ]] || ai_settings_lib="$(dirname -- "${BASH_SOURCE[0]}")/../assets/lib/ai-settings.sh"
# shellcheck source=assets/lib/ai-settings.sh
source "$ai_settings_lib"

readonly SCRIPT_NAME="${0##*/}"

# systemd.journal-fields(7)：systemd-coredump 用这个固定 MESSAGE_ID 记录每次核心转储，
# 其结构化字段（COREDUMP_*）比核心文件名包含更多信息。
readonly COREDUMP_MESSAGE_ID=fc2e22bc6ee647b6b90729ab34a250b1

# 崩溃循环会反复转储，同一程序在一个窗口内只提醒一次。
#
# 必须校验：这个值参与算术运算，`set -u` 下非数字（例如设成 abc）会让整个 watcher
# 立刻退出；叠加 Restart=always 就变成"每次崩溃重启一次服务"，功能整体静默失效。
dedupe_seconds="${CACHYOS_CRASH_DEDUPE_SECONDS:-60}"
if [[ ! $dedupe_seconds =~ ^[0-9]+$ ]]; then
    printf '%s: CACHYOS_CRASH_DEDUPE_SECONDS 不是非负整数（%s），回退到 60\n' "$SCRIPT_NAME" "$dedupe_seconds" >&2
    dedupe_seconds=60
fi
readonly DEDUPE_SECONDS="$dedupe_seconds"

# 匹配这个扩展正则的程序名永不提醒。
readonly IGNORE_PATTERN="${CACHYOS_CRASH_IGNORE:-}"

# 动作式通知（点击即诊断）默认为开：目标机器上已实测 DMS（quickshell）会回发
# ActionInvoked，`notify-send -A -w` 能拿到动作名（见计划的 Spike A）。设
# CACHYOS_CRASH_ACTION=0 退回纯提示式；动作式发不出去时也会自动退回提示式。
readonly ACTION_NOTIFY="${CACHYOS_CRASH_ACTION:-1}"

readonly STATE_DIR="$HOME/.local/state/cachyos-desktop"
readonly AGENTS_DIR="$STATE_DIR/agents"
readonly MUTE_FILE="$AGENTS_DIR/crash-muted.txt"
readonly LAST_CRASH_FILE="$AGENTS_DIR/last-crash"

# 订阅建立时刻（微秒）。`-f -n 1` 会先把最后一条历史记录带出来，比它早的记录一律丢弃。
# 在 watch 里赋值、在 handle_entry 里读，所以必须是全局变量。
BOOT_TIMESTAMP=""

declare -A last_notified=()

# 每个程序最多保留一个"待用户处理"的通知。动作式通知会一直等到用户处理（-t 0 不自动
# 过期），若每次都新起一个，崩溃循环会让进程数无上界增长——每组等待占用 3 个进程
#（后台子 shell + 命令替换 + notify-send -w）。键为程序名，值为该组等待进程的 PID。
declare -A notification_pids=()

usage() {
    cat <<EOF
Usage: $SCRIPT_NAME

常驻监听 systemd-coredump，把每次崩溃记录到
  $LAST_CRASH_FILE
并发送一条通知。同一程序 ${DEDUPE_SECONDS} 秒内只提醒一次；已静音的程序跳过
（见 cachyos-crash-mute）。

环境变量：
  CACHYOS_CRASH_DEDUPE_SECONDS  去重窗口秒数（默认 60）
  CACHYOS_CRASH_IGNORE          程序名正则，匹配则永不提醒
  CACHYOS_CRASH_ACTION          置 0 退回纯提示式通知（默认为可点击的动作式）
EOF
}

require_jq() {
    # jq 来自 DAILY_APP_PACKAGES，安装器运行 preflight 时还没有它，因此在这里检查
    # 而不是把它加进 preflight 的必需命令。
    if ! command -v jq >/dev/null 2>&1; then
        printf '%s: 需要 jq 来解析 coredump 记录\n' "$SCRIPT_NAME" >&2
        return 1
    fi
}

crash_is_muted() {
    [[ -s $MUTE_FILE ]] || return 1
    grep -Fxq -- "$1" "$MUTE_FILE"
}

record_crash() {
    local pid="$1"
    local comm="$2"
    local exe="$3"
    local signal="$4"
    local when="$5"
    local temporary

    install -d -m 0700 "$AGENTS_DIR"
    temporary="$(mktemp "$AGENTS_DIR/.last-crash.XXXXXX")"
    {
        printf 'pid=%s\n' "$pid"
        printf 'comm=%s\n' "$comm"
        printf 'exe=%s\n' "$exe"
        printf 'signal=%s\n' "$signal"
        printf 'time=%s\n' "$when"
    } > "$temporary"
    mv -- "$temporary" "$LAST_CRASH_FILE"
}

# shell 持有 org.freedesktop.Notifications，shell 崩溃会把通知服务一起带走，此时发出的
# 通知会丢失——而最该送达的那条恰恰最可能是它。所以先等 DMS 回来。
wait_for_notifier() {
    command -v systemctl >/dev/null 2>&1 || return 0
    for _ in 1 2 3 4 5; do
        systemctl --user is-active --quiet dms.service 2>/dev/null && return 0
        sleep 1
    done
    return 0
}

notification_is_pending() {
    local comm="$1"
    local pid="${notification_pids[$comm]:-}"

    [[ -n $pid ]] || return 1
    kill -0 "$pid" 2>/dev/null
}

send_notification() {
    local pid="$1"
    local comm="$2"
    local exe="$3"
    local signal="$4"
    local summary="进程崩溃：$comm"
    local body="点击诊断，或执行 cachyos-agent-crash --latest"

    wait_for_notifier

    # 这个程序已经有一条还没被处理的通知：不再发新的，也不新起等待进程。
    if notification_is_pending "$comm"; then
        return 0
    fi

    # 整个通知过程放到后台：动作式通知 `-w` 会一直等到用户处理，若同步执行，用户还没点
    # 的这段时间里发生的崩溃都不会被记录——正是最需要记录的时候。子 shell 里不能再用
    # local，因此下面的变量都是子 shell 自己的。
    (
        if [[ $ACTION_NOTIFY == 1 ]]; then
            # -t 0 表示不自动过期：崩溃提示要留到用户处理，默认的 10 秒太容易错过
            #（已实测 DMS 接受 0）。
            if action="$(notify-send --urgency=critical -t 0 -A diagnose="用 AI 诊断" -w "$summary" "$body" 2>/dev/null)"; then
                if [[ $action == "diagnose" ]]; then
                    # 四个字段都在手上，一并传下去：只传 PID 会让提示词里全是 unknown，
                    # 而通知可能挂几小时，期间 PID 可能已被复用。
                    cachyos-agent-crash "$pid" "$comm" "$exe" "$signal" >/dev/null 2>&1 || true
                fi
                exit 0
            fi
            # 动作式发不出去（例如没有通知服务）就退回提示式，别让这次崩溃悄悄消失。
        fi

        # 崩溃详情以独立 argv 传给处理命令，绝不拼接进命令行：进程名是攻击者可控的。
        notify-send --urgency=critical -t 0 "$summary" "$body" 2>/dev/null && exit 0
        if command -v dms >/dev/null 2>&1; then
            dms notify "$summary" "$body" 2>/dev/null && exit 0
        fi
    ) &
    notification_pids["$comm"]=$!

    return 0
}

handle_entry() {
    local entry="$1"
    local timestamp=""
    local pid=""
    local comm=""
    local exe=""
    local signal=""
    local when=""
    local now
    local previous

    # IFS 用**非空白**分隔符（US，0x1f）。制表符看着够用，其实不行：它属于 IFS 空白
    # 字符，read 会把连续分隔符折叠成一个，缺失的 COREDUMP_EXE 会让 signal 顶到 exe
    # 列，崩溃事实整体错位。非空白分隔符才保留空字段。
    # jq 失败（残缺记录）就跳过，不能让常驻进程退出。
    IFS=$'\x1f' read -r timestamp pid comm exe signal < <(
        jq -r '[
            (.__REALTIME_TIMESTAMP // ""),
            (.COREDUMP_PID // ""),
            (.COREDUMP_COMM // ""),
            (.COREDUMP_EXE // ""),
            (.COREDUMP_SIGNAL // "")
        ] | join("\u001f")' <<<"$entry" 2>/dev/null
    ) || return 0

    # 启动水位：`-f -n 1` 会在订阅建立时先把 journal 里**最后一条** coredump 记录带出来，
    # 那条是历史崩溃（可能几小时前，当时还没人在听）。直接用会让每次重启服务都补发一条
    # 过时通知，所以按时间戳把它连同更早的记录一起挡掉。
    # 时间戳缺失或非数字（残缺记录）也一并跳过——宁可漏一条，也不能拿垃圾数据去发通知。
    [[ $timestamp =~ ^[0-9]+$ ]] || return 0
    ((timestamp > BOOT_TIMESTAMP)) || return 0

    [[ -n $comm ]] || return 0

    if [[ -n $IGNORE_PATTERN ]] && [[ $comm =~ $IGNORE_PATTERN ]]; then
        return 0
    fi
    if crash_is_muted "$comm"; then
        return 0
    fi

    now="$(date +%s)"
    previous="${last_notified[$comm]:-0}"
    if ((now - previous < DEDUPE_SECONDS)); then
        return 0
    fi
    last_notified["$comm"]="$now"

    when="$(date '+%Y-%m-%d %H:%M:%S')"
    record_crash "$pid" "$comm" "$exe" "$signal" "$when"
    send_notification "$pid" "$comm" "$exe" "$signal"
}

watch() {
    local entry

    require_jq || exit 1

    # **不要用 `-f -n 0`**：实测 systemd 262 上，`-n 0` 只要和任何过滤条件组合
    # （MESSAGE_ID= / -k / -t / -u）就会静默返回 0 行——服务看着 active、日志一句错误
    # 都没有，实际永远收不到任何事件（本机 journal 里有 5 条真实 coredump，这条订阅却
    # 一条都没读到）。改用 `-f -n 1`，用启动时刻作为水位丢掉带出来的那条旧记录。
    BOOT_TIMESTAMP="$(date +%s%6N)"

    # 进程替换而非管道：管道会把 while 放进子 shell，去重表会随之丢失。
    # 外层循环让 journalctl 因日志轮转退出后能自动重连。
    #
    # 不吞 journalctl 的 stderr：它永久失败时服务看着 active 却什么都不做，那条错误是
    # 唯一线索。重连也记一行，便于区分"没有崩溃"和"根本没读到日志"。
    while true; do
        while IFS= read -r entry; do
            handle_entry "$entry" || true
        done < <(journalctl -f -n 1 -o json "MESSAGE_ID=$COREDUMP_MESSAGE_ID")
        printf '%s: journalctl 已退出，2 秒后重连\n' "$SCRIPT_NAME" >&2
        sleep 2
    done
}

case "${1:-}" in
    -h|--help)
        usage
        exit 0
        ;;
    "")
        watch
        ;;
    *)
        printf '%s: 未知参数 %s\n' "$SCRIPT_NAME" "$1" >&2
        usage >&2
        exit 2
        ;;
esac
