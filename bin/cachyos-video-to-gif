#!/usr/bin/env bash

set -Eeuo pipefail
[[ $# -eq 1 && -f "$1" ]] || { printf 'Usage: %s VIDEO\n' "${0##*/}" >&2; exit 2; }
output="${1%.*}.gif"
ffmpeg -hide_banner -loglevel warning -y -i "$1" \
    -vf "fps=15,scale='min(1280,iw)':-2:flags=lanczos,split[s0][s1];[s0]palettegen[p];[s1][p]paletteuse" \
    "$output"
