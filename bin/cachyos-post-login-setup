#!/usr/bin/env bash

set -uo pipefail

state_dir="$HOME/.local/state/cachyos-desktop"
marker="$state_dir/post-login-v2"
log_file="$state_dir/post-login.log"
mkdir -p -- "$state_dir"
[[ ! -e "$marker" ]] || exit 0

exec 9>"$state_dir/post-login.lock"
flock -n 9 || exit 0
notify-send 'CachyOS desktop' 'Finishing Firefox, Code, Wine, and agent skill setup in the background.' 2>/dev/null || true

failed=false
for command_name in cachyos-agent-skills cachyos-firefox-setup cachyos-code-theme cachyos-wine-setup; do
    command_marker="$state_dir/${command_name}-v1"
    [[ ! -e "$command_marker" ]] || continue
    # 技能分发要带 --create-supported：首次登录时 .claude/.codex 往往还不存在
    # （CLI 装了但用户还没跑过），不带这个参数就会全部"跳过（目录不存在）"，
    # 用户用了 agent 也拿不到技能。
    command_args=()
    [[ $command_name == cachyos-agent-skills ]] && command_args+=(--create-supported)
    if ! "$command_name" "${command_args[@]+"${command_args[@]}"}" >>"$log_file" 2>&1; then
        printf '%s failed\n' "$command_name" >> "$log_file"
        failed=true
    else
        touch "$command_marker"
    fi
done

if [[ "$failed" == false ]]; then
    touch "$marker"
    notify-send 'CachyOS desktop' 'Firefox, Code, Wine, and agent skill setup completed.' 2>/dev/null || true
else
    notify-send 'CachyOS desktop' "Some first-login setup failed. See $log_file" 2>/dev/null || true
fi
